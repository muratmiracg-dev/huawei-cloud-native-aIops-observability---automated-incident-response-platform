ENVIRONMENT=local
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=huawei-aiops
ENABLE_TRACING=true
ENABLE_FAULT_INJECTION=false
INCIDENT_AUTOMATION_MODE=dry-run
INCIDENT_COOLDOWN_SECONDS=300
CATALOG_URL=http://catalog-api:8001
PAYMENTS_URL=http://payments-api:8003
DATABASE_URL=postgresql+psycopg://aiops:change-me@postgres:5432/aiops
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
